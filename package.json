{
  "name": "wintermaul-mobile-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prune-production-assets.mjs && node scripts/report-production-size.mjs",
    "preview": "vite preview",
    "preview:pages": "node scripts/serve-pages-subpath.mjs",
    "test:enemy-waves": "node --import ./scripts/register-ts-loader.mjs scripts/test-enemy-waves.mjs && node --import ./scripts/register-ts-loader.mjs scripts/test-content-combat.mjs && npm run test:gameplay-depth",
    "test:content-combat": "node --import ./scripts/register-ts-loader.mjs scripts/test-content-combat.mjs",
    "test:gameplay-depth": "node --import ./scripts/register-ts-loader.mjs scripts/test-gameplay-depth.mjs",
    "test:faction-bonuses": "node --import ./scripts/register-ts-loader.mjs scripts/test-faction-bonuses.mjs",
    "test:defender-specializations": "node --import ./scripts/register-ts-loader.mjs scripts/test-defender-specializations.mjs",
    "test:holy-emperor": "node --import ./scripts/register-ts-loader.mjs scripts/test-holy-emperor.mjs",
    "test:build-ux": "node scripts/test-build-ux.cjs",
    "test:content-assets": "node scripts/test-content-assets.cjs",
    "test:enemy-animation": "node scripts/test-enemy-animation.cjs",
    "audit:meshy-goblin": "node scripts/audit-meshy-goblin.mjs",
    "test:meshy-goblin": "node scripts/audit-meshy-goblin.mjs && node scripts/test-meshy-goblin.cjs",
    "test:performance-build": "node scripts/test-performance-build.mjs",
    "audit:assets": "node scripts/audit-runtime-assets.mjs --write scripts/asset-inventory-current.md",
    "test:map-adjustments": "node --import ./scripts/register-ts-loader.mjs scripts/test-map-adjustments.mjs",
    "test:shortest-routes": "node --import ./scripts/register-ts-loader.mjs scripts/test-shortest-routes.mjs",
    "test:multiplayer": "node --import ./scripts/register-ts-loader.mjs scripts/test-multiplayer-phase1.mjs",
    "test:ancient-grove-units": "node --import ./scripts/register-ts-loader.mjs scripts/test-ancient-grove-units.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.27.1",
    "@babylonjs/loaders": "^9.27.1",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
